rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin check: any user whose Firestore document has role == 'admin'
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Games ────────────────────────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isOwner(uid);
      }
    }

    // ── Companies ────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Rounds ───────────────────────────────────────────────────────────────
    match /rounds/{roundId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      // Students can update their own open rounds (to save decisions)
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.status == 'open') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Leaderboard ──────────────────────────────────────────────────────────
    match /leaderboard/{gameId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /entries/{uid} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ── Admins collection (optional) ─────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
